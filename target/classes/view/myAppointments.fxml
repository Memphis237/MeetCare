<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.meetcare.controller.MyAppointmentsController"
            prefWidth="1200"
            prefHeight="720"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="12" style="-fx-padding: 16;">
                <VBox spacing="2">
                    <Label text="Mes rendez-vous" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Gerez vos consultations" style="-fx-font-size: 18px; -fx-text-fill: #64748b;"/>
                </VBox>

                <HBox spacing="10" styleClass="tabs">
                    <Button fx:id="confirmedTabButton" text="Confirmes" styleClass="tab-active"/>
                    <Button fx:id="completedTabButton" text="Termines (0)" styleClass="tab-button"/>
                    <Button fx:id="cancelledTabButton" text="Annules (0)" styleClass="tab-button"/>
                </HBox>

                <VBox fx:id="appointmentsContainer" spacing="12"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
