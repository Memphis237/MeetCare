<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.HomeMedecinController"
            prefWidth="1100" prefHeight="700"
            style="-fx-background-color: #EBF3FB;">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  SIDEBAR GAUCHE                                                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <left>
       <fx:include source="sidebarMedecin.fxml"/>
    </left>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!--  CONTENU PRINCIPAL                                               -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 28 28 28 28; -fx-background-color: #EBF3FB;">

                <!-- En-tete -->
                <VBox spacing="4">
                    <Label text="Bienvenue, Dr. Martin"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                    <Label text="Vue d'ensemble de votre activite"
                           style="-fx-font-size: 13px; -fx-text-fill: #6B8CAD;"/>
                </VBox>

                <!-- 4 cartes statistiques -->
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    </columnConstraints>

                    <!-- Rendez-vous du jour -->
                    <VBox GridPane.columnIndex="0" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                        <Label text="Rendez-vous du jour"
                               style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;" wrapText="true"/>
                        <Label text="4"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                        <Label text="3 confirmes, 1 teleconsultation"
                               style="-fx-font-size: 11px; -fx-text-fill: #6B8CAD;" wrapText="true"/>
                    </VBox>

                    <!-- Cette semaine -->
                    <VBox GridPane.columnIndex="1" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                        <Label text="Cette semaine"
                               style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                        <Label text="18"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                        <Label text="Rendez-vous planifies"
                               style="-fx-font-size: 11px; -fx-text-fill: #6B8CAD;"/>
                    </VBox>

                    <!-- Patients uniques -->
                    <VBox GridPane.columnIndex="2" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                        <Label text="Patients uniques"
                               style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                        <Label text="142"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                        <Label text="Total patients suivis"
                               style="-fx-font-size: 11px; -fx-text-fill: #6B8CAD;"/>
                    </VBox>

                    <!-- Taux de remplissage -->
                    <VBox GridPane.columnIndex="3" spacing="6"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                        <Label text="Taux de remplissage"
                               style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;" wrapText="true"/>
                        <Label text="87%"
                               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #3DAA70;"/>
                        <Label text="Cette semaine"
                               style="-fx-font-size: 11px; -fx-text-fill: #6B8CAD;"/>
                    </VBox>
                </GridPane>

                <!-- Bloc Rendez-vous d'aujourd'hui -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22;
                             -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">

                    <!-- En-tete du bloc -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Rendez-vous d'aujourd'hui"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"
                               HBox.hgrow="ALWAYS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Voir l'agenda complet"
                                style="-fx-background-color: #EBF3FB; -fx-text-fill: #1A2C42;
                                       -fx-font-size: 12px; -fx-font-weight: bold;
                                       -fx-background-radius: 8; -fx-padding: 9 16 9 16;
                                       -fx-border-color: #C8DDEF; -fx-border-radius: 8;"/>
                    </HBox>

                    <!-- RDV 1 : Marie Dubois -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: #F5F9FD; -fx-background-radius: 10;
                                 -fx-padding: 14 16 14 16; -fx-border-color: #E0EEF8;
                                 -fx-border-radius: 10; -fx-border-width: 1;">
                        <!-- Heure -->
                        <Label text="09:00"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;
                                      -fx-background-color: #D6E9F8; -fx-background-radius: 6;
                                      -fx-padding: 5 10 5 10;"/>
                        <!-- Infos patient -->
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Marie Dubois"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                            <Label text="Consultation generale"
                                   style="-fx-font-size: 12px; -fx-text-fill: #6B8CAD;"/>
                        </VBox>
                        <!-- Badge type -->
                        <Label text="Cabinet"
                               style="-fx-font-size: 11px; -fx-text-fill: #4A6B8A;
                                      -fx-background-color: #E8F0F8; -fx-background-radius: 6;
                                      -fx-padding: 4 12 4 12; -fx-border-color: #C8DDEF;
                                      -fx-border-radius: 6; -fx-border-width: 1;"/>
                    </HBox>

                    <!-- RDV 2 : Pierre Martin -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: #F5F9FD; -fx-background-radius: 10;
                                 -fx-padding: 14 16 14 16; -fx-border-color: #E0EEF8;
                                 -fx-border-radius: 10; -fx-border-width: 1;">
                        <Label text="10:30"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;
                                      -fx-background-color: #D6E9F8; -fx-background-radius: 6;
                                      -fx-padding: 5 10 5 10;"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Pierre Martin"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                            <Label text="Suivi cardiologique"
                                   style="-fx-font-size: 12px; -fx-text-fill: #6B8CAD;"/>
                        </VBox>
                        <Label text="Cabinet"
                               style="-fx-font-size: 11px; -fx-text-fill: #4A6B8A;
                                      -fx-background-color: #E8F0F8; -fx-background-radius: 6;
                                      -fx-padding: 4 12 4 12; -fx-border-color: #C8DDEF;
                                      -fx-border-radius: 6; -fx-border-width: 1;"/>
                    </HBox>

                    <!-- RDV 3 : Sophie Bernard -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: #F5F9FD; -fx-background-radius: 10;
                                 -fx-padding: 14 16 14 16; -fx-border-color: #E0EEF8;
                                 -fx-border-radius: 10; -fx-border-width: 1;">
                        <Label text="14:00"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;
                                      -fx-background-color: #D6E9F8; -fx-background-radius: 6;
                                      -fx-padding: 5 10 5 10;"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Sophie Bernard"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                            <Label text="Controle"
                                   style="-fx-font-size: 12px; -fx-text-fill: #6B8CAD;"/>
                        </VBox>
                        <Label text="Teleconsultation"
                               style="-fx-font-size: 11px; -fx-text-fill: #5A8AAA;
                                      -fx-background-color: #D6EAF5; -fx-background-radius: 6;
                                      -fx-padding: 4 12 4 12; -fx-border-color: #A8CCE0;
                                      -fx-border-radius: 6; -fx-border-width: 1;"/>
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
