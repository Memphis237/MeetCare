<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #F8F9FB; -fx-background: #F8F9FB;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.meetcare.controller.DisponibilitesController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <content>
        <VBox spacing="20" style="-fx-padding: 25 25 60 25;" >
            <children>
                
                <VBox spacing="5.0">
                    <children>
                        <Label text="Disponibilités" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;" />
                        <Label text="Goutez à une gestion fluide de vos créneaux de consultation" style="-fx-text-fill: #6B8CAD; -fx-font-size: 14px;" />
                    </children>
                </VBox>

                <GridPane hgap="20.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                    </columnConstraints>
                    <children>
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);" GridPane.columnIndex="0">
                            <children>
                                <Label style="-fx-text-fill: #6B8CAD; -fx-font-size: 13px; -fx-font-weight: bold;" text="Total créneaux" />
                                <Region prefHeight="10.0" />
                                <Label fx:id="lblTotal" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A73E8;" text="0" />
                            </children>
                        </VBox>
                        
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);" GridPane.columnIndex="1">
                            <children>
                                <Label style="-fx-text-fill: #6B8CAD; -fx-font-size: 13px; -fx-font-weight: bold;" text="Créneaux disponibles" />
                                <Region prefHeight="10.0" />
                                <Label fx:id="lblDispo" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #13DEB9;" text="0" />
                            </children>
                        </VBox>
                        
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);" GridPane.columnIndex="2">
                            <children>
                                <Label style="-fx-text-fill: #6B8CAD; -fx-font-size: 13px; -fx-font-weight: bold;" text="Créneaux occupés" />
                                <Region prefHeight="10.0" />
                                <Label fx:id="lblOccupe" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #FFAE1F;" text="0" />
                            </children>
                        </VBox>
                        
                        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);" GridPane.columnIndex="3">
                            <children>
                                <Label style="-fx-text-fill: #6B8CAD; -fx-font-size: 13px; -fx-font-weight: bold;" text="Taux de disponibilité" />
                                <Region prefHeight="10.0" />
                                <Label fx:id="lblTaux" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #A855F7;" text="0%" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <HBox alignment="TOP_LEFT" spacing="25.0">
                    <children>
                        
                        <VBox spacing="15.0" prefWidth="350.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);">
                            <children>
                                <Label text="Calendrier" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;" />
                                <VBox fx:id="calendarPlaceHolder" spacing="12" style="-fx-background-color: #F8F9FB; -fx-background-radius: 8; -fx-padding: 10;" />
                            </children>
                        </VBox>

                        <VBox HBox.hgrow="ALWAYS" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);">
                            <children>
                                <Label fx:id="labelCreneaux" text="Vos Créneaux d'aujourd'hui" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;" />
                                <GridPane fx:id="gridCreneaux" hgap="15.0" vgap="15.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                    </columnConstraints>
                                </GridPane>
                            </children>
                        </VBox>
                        
                    </children>
                </HBox>

                <HBox>
                    <children>
                        <VBox prefWidth="350.0" spacing="16" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, #E0E8F0, 8, 0, 0, 2);">
                            <children>
                                <Label text="Ajouter un créneau" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1A2C42;" />
            
                                <VBox spacing="8">
                                    <children>
                                        <Label text="Heure de début" style="-fx-text-fill: #6B8CAD; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                        <TextField fx:id="txtHeureDebut" promptText="ex: 15:30" style="-fx-background-color: #F8F9FB; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #E0E8F0; -fx-border-radius: 8; -fx-text-fill: #1A2C42;" />
                                    </children>
                                </VBox>
            
                                <VBox spacing="8">
                                    <children>
                                        <Label text="Heure de fin" style="-fx-text-fill: #6B8CAD; -fx-font-weight: bold; -fx-font-size: 13px;" />
                                        <TextField fx:id="txtHeureFin" promptText="ex: 16:00" style="-fx-background-color: #F8F9FB; -fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #E0E8F0; -fx-border-radius: 8; -fx-text-fill: #1A2C42;" />
                                    </children>
                                </VBox>
            
                                <Button fx:id="btnAjouter" maxWidth="Infinity" onAction="#handleAjouterCreneau" style="-fx-background-color: #A855F7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-cursor: hand;" text="+   Ajouter le créneau" />
                            </children>
                        </VBox>
                        
                    </children>
                </HBox>
                
            </children>
        </VBox>
    </content>
</ScrollPane>
