<BorderPane prefHeight="700" prefWidth="1100" style="-fx-background-color: #F2F2F2;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.meetcare.controller.InvoicePatientController">

