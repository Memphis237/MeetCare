                    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: #FFF3EC; -fx-background-radius: 12; -fx-padding: 18 20 18 20;                                  -fx-border-color: #F5D5C0; -fx-border-radius: 12; -fx-border-width: 1;">
