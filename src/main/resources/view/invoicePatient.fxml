            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Separator />

                  <!-- Deconnexion -->
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleLogout" style="-fx-padding: 16 20 16 20; -fx-cursor: hand;">
