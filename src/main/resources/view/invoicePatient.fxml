<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.InvoicePatientController"
            prefWidth="1100"
            prefHeight="700"
            stylesheets="@../css/patient-pages.css"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f8fafc;">

                <VBox spacing="4">
                    <Label text="Factures" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="Gerez vos paiements et vos factures medicales" style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="Total en attente" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="totalPendingAmountLabel" text="0,00 €" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                    </VBox>
                    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="Factures en attente" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="pendingInvoicesCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="Factures payees" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label fx:id="paidInvoicesCountLabel" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>
                </HBox>

                <VBox spacing="12">
                    <Label text="Factures en attente" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <VBox fx:id="pendingInvoicesContainer" spacing="12"/>
                </VBox>

                <VBox spacing="12">
                    <Label text="Factures payees" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <VBox fx:id="paidInvoicesContainer" spacing="12"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
