<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.InvoicePatientController"
            prefWidth="1100"
            prefHeight="700"
            stylesheets="@../css/patient-pages.css"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: #f8fafc;">

                <VBox spacing="4">
                    <Label text="Factures" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    <Label text="Gerez vos paiements et vos factures medicales" style="-fx-font-size: 15px; -fx-text-fill: #64748b;"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="Total en attente" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label text="75 EUR" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                    </VBox>
                    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="Factures en attente" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label text="2" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                    </VBox>
                    <VBox spacing="8" styleClass="card" HBox.hgrow="ALWAYS">
                        <Label text="Factures payees" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        <Label text="2" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    </VBox>
                </HBox>

                <VBox spacing="12">
                    <Label text="Factures en attente" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="appointment-card">
                        <StackPane>
                            <Circle radius="26" style="-fx-fill: #ffedd5;"/>
                            <Label text="E" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                        </StackPane>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Dr. Marc Dubois" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                            <Label text="Generaliste" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                            <Label text="28/04/2026 - Consultation generale" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT">
                            <Label text="25 EUR" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                            <Label text="En attente" styleClass="badge-orange"/>
                        </VBox>
                        <Button text="Telecharger" styleClass="secondary-button"/>
                        <Button text="Payer" styleClass="primary-button"/>
                    </HBox>

                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="appointment-card">
                        <StackPane>
                            <Circle radius="26" style="-fx-fill: #ffedd5;"/>
                            <Label text="E" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                        </StackPane>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Dr. Julie Bernard" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                            <Label text="Dermatologue" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                            <Label text="20/04/2026 - Consultation dermatologique" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT">
                            <Label text="50 EUR" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #ea580c;"/>
                            <Label text="En attente" styleClass="badge-orange"/>
                        </VBox>
                        <Button text="Telecharger" styleClass="secondary-button"/>
                        <Button text="Payer" styleClass="primary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="12">
                    <Label text="Factures payees" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>

                    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="appointment-card">
                        <StackPane>
                            <Circle radius="26" style="-fx-fill: #dcfce7;"/>
                            <Label text="P" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        </StackPane>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Dr. Sarah Martin" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                            <Label text="Cardiologue" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                            <Label text="05/04/2026 - Consultation de suivi" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT">
                            <Label text="30 EUR" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                            <Label text="Payee" styleClass="badge-green"/>
                        </VBox>
                        <Button text="Telecharger" styleClass="secondary-button"/>
                    </HBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
