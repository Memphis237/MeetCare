<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.DisponibilitesMedecinController"
            prefWidth="1200"
            prefHeight="760"
            stylesheets="@../css/doctor-pages.css"
            style="-fx-background-color: #f8fafc;">
    <left>
        <fx:include source="sidebarMedecin.fxml"/>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 24;">
                <VBox spacing="2">
                    <Label text="Disponibilites" styleClass="doctor-title"/>
                    <Label text="Definissez les moments ou les patients peuvent reserver." styleClass="doctor-subtitle"/>
                </VBox>

                <HBox spacing="12" styleClass="doctor-card">
                    <DatePicker fx:id="availabilityDatePicker" prefWidth="220" prefHeight="42"/>
                    <Button text="+ Ajouter un creneau" onAction="#handleAddSlot" styleClass="doctor-primary-button"/>
                    <Button text="Bloquer la journee" onAction="#handleBlockDay" styleClass="doctor-outline-button"/>
                    <Button text="Retirer le blocage" onAction="#handleClearDay" styleClass="doctor-outline-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="availabilityCountLabel" text="0 creneau" styleClass="doctor-subtitle"/>
                </HBox>

                <VBox fx:id="slotsContainer" spacing="12"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
