<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f8f9fb; -fx-background: #f8f9fb;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.meetcare.controller.PatientListController">
    <content>
        <VBox spacing="20" style="-fx-padding: 25;">

            <VBox spacing="5">
                <Label text="Patients" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;" />
                <Label text="Liste de vos patients et rendez-vous" style="-fx-font-size: 14px; -fx-text-fill: #6B8CAD;" />
            </VBox>

            <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12 20; -fx-effect: dropshadow(gaussian,#e0e8f0,8,0,0,2);">
                <Label text="🔍" style="-fx-text-fill: #6B8CAD; -fx-font-size: 16px;" />
                <TextField fx:id="txtRecherche" promptText="Rechercher un patient par nom ou email..." style="-fx-background-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS"/>
            </HBox>

            <Label fx:id="lblNbPatients" text="0 patient(s)" style="-fx-text-fill: #6B8CAD; -fx-font-size: 13px;" />

            <VBox fx:id="vboxPatientsList" spacing="12">
                </VBox>

        </VBox>
    </content>
</ScrollPane>