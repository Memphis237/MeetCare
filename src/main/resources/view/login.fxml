<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="520" prefWidth="620" style="-fx-background-color: linear-gradient(to bottom right, #a8c8f0, #d6eaf8);" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.meetcare.controller.LoginController">

    <padding>
        <Insets bottom="24" left="24" right="24" top="24" />
    </padding>

    <VBox alignment="CENTER" maxWidth="400" prefHeight="434.0" prefWidth="400.0" spacing="16" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,40,100,0.18), 28, 0, 0, 8);" StackPane.alignment="CENTER">

        <padding>
            <Insets bottom="40" left="50" right="50" top="40" />
        </padding>

        <StackPane maxHeight="72" maxWidth="72" prefHeight="72" prefWidth="72" style="-fx-background-color: #2f6fd4; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(47,111,212,0.4), 12, 0, 0, 4);" StackPane.alignment="CENTER">
            <Label style="-fx-font-size: 28px;" text="👤" />
        </StackPane>

        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2540;" text="Connexion" />

        <Label fx:id="messageLabel" maxWidth="300" styleClass="msg-label" wrapText="true" />

        <VBox spacing="5">
            <Label styleClass="form-label" text="Nom d'utilisateur" />
            <TextField fx:id="username" prefWidth="300" promptText="Entrez votre nom d'utilisateur" styleClass="auth-field" />
        </VBox>

        <VBox spacing="5">
            <Label styleClass="form-label" text="Mot de passe" />
            <PasswordField fx:id="password" prefWidth="300" promptText="Entrez votre mot de passe" styleClass="auth-field" />
        </VBox>

        <Button fx:id="loginButton" onAction="#handleLogin" prefWidth="300" styleClass="btn-primary" text="Connexion" />

        <Hyperlink fx:id="hyperlink" onAction="#handleRegister" styleClass="auth-link" text="Pas de compte ? S'inscrire" />

        <Label style="-fx-font-size: 18px; -fx-text-fill: #c5d0dc; -fx-opacity: 0.7;" text="🔒" />

    </VBox>
</StackPane>
