<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane
    prefHeight="520" prefWidth="620"
    style="-fx-background-color: linear-gradient(to bottom right, #a8c8f0, #d6eaf8);"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.meetcare.controller.LoginController">

    <!-- Carte blanche centrée -->
    <VBox alignment="CENTER" spacing="16"
          prefWidth="400"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,40,100,0.18), 28, 0, 0, 8);"
          StackPane.alignment="CENTER">

        <padding>
            <Insets top="40" right="50" bottom="40" left="50"/>
        </padding>

        <!-- Icône cercle bleu -->
        <StackPane prefWidth="72" prefHeight="72" maxWidth="72" maxHeight="72"
                   style="-fx-background-color: #2f6fd4; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(47,111,212,0.4), 12, 0, 0, 4);"
                   StackPane.alignment="CENTER">
            <Label text="👤" style="-fx-font-size: 28px;"/>
        </StackPane>

        <!-- Titre -->
        <Label text="Connexion"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2540;"/>

        <!-- Message retour -->
        <Label fx:id="messageLabel" wrapText="true" maxWidth="300" styleClass="msg-label"/>

        <!-- Nom d'utilisateur -->
        <VBox spacing="5">
            <Label text="Nom d'utilisateur" styleClass="form-label"/>
            <TextField fx:id="username" promptText="Entrez votre nom d'utilisateur"
                       styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Mot de passe -->
        <VBox spacing="5">
            <Label text="Mot de passe" styleClass="form-label"/>
            <PasswordField fx:id="password" promptText="Entrez votre mot de passe"
                           styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Bouton Connexion -->
        <Button fx:id="loginButton" text="Connexion" onAction="#handleLogin"
                styleClass="btn-primary" prefWidth="300"/>

        <!-- Lien inscription -->
        <Hyperlink fx:id="hyperlink" text="Pas de compte ? S'inscrire"
                   onAction="#handleRegister" styleClass="auth-link"/>

        <!-- Cadenas décoratif -->
        <Label text="🔒" style="-fx-font-size: 18px; -fx-text-fill: #c5d0dc; -fx-opacity: 0.7;"/>

    </VBox>
</StackPane>
