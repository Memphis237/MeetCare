<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="800.0" prefWidth="1280.0" styleClass="main-container" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      
      <!-- Sidebar Gauche -->
      <VBox prefWidth="280.0" spacing="10.0" styleClass="sidebar">
         <children>
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Circle fill="#E0E5F2" radius="40.0" stroke="TRANSPARENT" />
                  <Label style="-fx-font-weight: bold;" text="Jean" textFill="#1B2559">
                     <font><Font size="18.0" /></font>
                  </Label>
                  <Label text="Cardiologue" textFill="#A3AED0" />
               </children>
               <VBox.margin><Insets bottom="40.0" /></VBox.margin>
            </VBox>

            <Button maxWidth="1.7976931348623157E308" styleClass="nav-button, nav-button-active" text="      🏠   Accueil">
               <padding><Insets bottom="15.0" top="15.0" /></padding></Button>
            <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="      🔍   Rechercher" />
            <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="      📅   Mes rendez-vous" />
            <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="      📄   Documents" />
            <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="      💳   Factures" />
            <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="      ✉   Messages" />
            
            <Region VBox.vgrow="ALWAYS" />
            
            <Button maxWidth="1.7976931348623157E308" style="-fx-text-fill: #EE5D50;" styleClass="nav-button" text="      ↪   Déconnexion">
               <VBox.margin><Insets bottom="20.0" /></VBox.margin>
            </Button>
         </children>
      </VBox>

      <!-- Contenu Central -->
      <VBox spacing="30.0" HBox.hgrow="ALWAYS">
         <padding><Insets bottom="30.0" left="40.0" right="40.0" top="40.0" /></padding>
         <children>
            
            <VBox>
               <children>
                  <Label text="Bienvenue, Jean" textFill="#1B2559">
                     <font><Font name="System Bold" size="34.0" /></font>
                  </Label>
                  <Label text="Votre espace santé personnel" textFill="#A3AED0">
                     <font><Font size="16.0" /></font></Label>
               </children>
            </VBox>

            <HBox spacing="25.0">
               <children>
                  <VBox prefHeight="120.0" prefWidth="220.0" styleClass="card">
                     <padding><Insets bottom="20.0" left="25.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label styleClass="card-title" text="Rendez-vous" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Label styleClass="card-value" text="5" />
                        <Label text="À venir" textFill="#01B574" />
                     </children>
                  </VBox>
                  <VBox prefHeight="120.0" prefWidth="220.0" styleClass="card">
                     <padding><Insets bottom="20.0" left="25.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label styleClass="card-title" text="Documents" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Label styleClass="card-value" text="12" />
                        <Label text="Nouveaux reçus" textFill="#A3AED0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="25.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Section Prochain RDV -->
                  <VBox spacing="20.0" styleClass="card" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label text="Prochain rendez-vous" textFill="#1B2559">
                                 <font><Font name="System Bold" size="20.0" /></font>
                              </Label>
                              <Region HBox.hgrow="ALWAYS" />
                              <Button style="-fx-background-radius: 10;" text="Voir les détails" />
                           </children>
                        </HBox>
                        <HBox spacing="20.0" style="-fx-background-color: #F4F7FE; -fx-background-radius: 20; -fx-padding: 25;">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Dr. Sarah Martin" textFill="#1B2559">
                                       <font><Font name="System Bold" size="18.0" /></font>
                                    </Label>
                                    <Label text="Cardiologue" textFill="#A3AED0" />
                                    <HBox spacing="15.0">
                                       <children>
                                          <Label text="📅 Lundi 5 mai 2026 à 14:30" />
                                          <Label style="-fx-background-color: #1B2559; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 2 8;" text="Confirmé" />
                                       </children>
                                       <VBox.margin><Insets top="10.0" /></VBox.margin>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <!-- Notifications -->
                  <VBox prefWidth="350.0" spacing="20.0" styleClass="card">
                     <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
                     <children>
                        <Label text="Notifications récentes" textFill="#1B2559">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <VBox spacing="15.0">
                           <HBox spacing="15.0" alignment="CENTER_LEFT">
                              <Circle fill="#0052FF" radius="5.0" />
                              <VBox>
                                 <Label style="-fx-font-weight: bold;" text="Rappel de rendez-vous" />
                                 <Label text="Votre RDV est dans 3 jours" textFill="#A3AED0" />
                              </VBox>
                           </HBox>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Tuiles d'action en bas -->
            <HBox spacing="25.0">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" styleClass="action-tile" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label text="🔍"> <font><Font size="24.0" /></font></Label>
                        <Label text="Rechercher un médecin" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="10.0" styleClass="action-tile" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label text="📅"> <font><Font size="24.0" /></font></Label>
                        <Label text="Gérer mes rendez-vous" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="10.0" styleClass="action-tile" HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                     <children>
                        <Label text="📂"> <font><Font size="24.0" /></font></Label>
                        <Label text="Mes documents" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>