<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Sidebar Gauche -->
    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 0 1 0 0;">
            <children>
                <Label text="MediConnect" textFill="#0052FF">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" left="20.0" top="20.0" />
                    </VBox.margin>
                </Label>

                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #EEF2FF; -fx-text-fill: #0052FF; -fx-background-radius: 5;" text="Accueil">
                    <padding><Insets bottom="10.0" left="20.0" top="10.0" /></padding>
                </Button>
                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent;" text="Rechercher">
                    <padding><Insets bottom="10.0" left="20.0" top="10.0" /></padding>
                </Button>
                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent;" text="Mes rendez-vous">
                    <padding><Insets bottom="10.0" left="20.0" top="10.0" /></padding>
                </Button>
                <!-- Ajouter les autres boutons ici... -->

                <Region VBox.vgrow="ALWAYS" />

                <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #D32F2F;" text="Déconnexion">
                    <padding><Insets bottom="20.0" left="20.0" top="10.0" /></padding>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- Contenu Principal -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8F9FA;">
            <content>
                <VBox spacing="25.0">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <!-- Header Message -->
                        <VBox>
                            <children>
                                <Label text="Bienvenue, Jean">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                                <Label text="Votre espace santé personnel" textFill="#757575" />
                            </children>
                        </VBox>

                        <!-- Grille de Cartes Stats -->
                        <HBox spacing="20.0">
                            <children>
                                <!-- Carte 1 -->
                                <VBox prefHeight="140.0" prefWidth="180.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="Rendez-vous" textFill="#212121" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label text="5" textFill="#0052FF">
                                            <font><Font name="System Bold" size="32.0" /></font>
                                        </Label>
                                        <Label text="À venir" textFill="#757575" />
                                    </children>
                                </VBox>
                                <!-- Répéter pour Documents, Factures, Messages -->
                                <VBox prefHeight="140.0" prefWidth="180.0" style="-fx-background-color: white; -fx-background-radius: 15;">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>
                                        <Label text="Documents" />
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Label text="12" textFill="#0052FF"><font><Font name="System Bold" size="32.0" /></font></Label>
                                        <Label text="Documents médicaux" textFill="#757575" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Section Prochain Rendez-vous -->
                        <VBox spacing="15.0">
                            <children>
                                <Label text="Prochain rendez-vous">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #EEF2FF; -fx-background-radius: 15; -fx-padding: 20;">
                                    <children>
                                        <StackPane style="-fx-background-color: white; -fx-background-radius: 10; -fx-min-width: 50; -fx-min-height: 50;">
                                            <!-- Remplacer par une icône FontAwesome ou un ImageView -->
                                            <Label text="📅" />
                                        </StackPane>
                                        <VBox HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label text="Dr. Sarah Martin">
                                                    <font><Font name="System Bold" size="16.0" /></font>
                                                </Label>
                                                <Label text="Cardiologue" textFill="#757575" />
                                                <HBox spacing="10.0">
                                                    <Label text="Lundi 5 mai 2026 à 14:30" />
                                                    <Label style="-fx-background-color: black; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 2 8;" text="Confirmé">
                                                        <font><Font size="10.0" /></font>
                                                    </Label>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <Button mnemonicParsing="false" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" text="Voir les détails" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>