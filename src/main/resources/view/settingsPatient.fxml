<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700" prefWidth="1100" style="-fx-background-color: #EBF3FB;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.SettingsPatientController">

    <left>
        <VBox prefWidth="230" spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D9E8F5; -fx-border-width: 0 1 0 0;">

            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 22 20 22 20;">
                <Label text="✚" style="-fx-text-fill: #2B7FD4; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="MediConnect" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
            </HBox>

            <Separator style="-fx-background-color: #D9E8F5;"/>

            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 18 20 18 20;">
                <StackPane>
                    <Circle fx:id="avatarCircle" radius="26"/>
                    <Label fx:id="avatarInitialsLabel" text="J"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;"/>
                </StackPane>
                <VBox spacing="2">
                    <Label fx:id="profileNameLabel" text="Jean"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                    <Label fx:id="profileRoleLabel" text="Patient"
                           style="-fx-font-size: 12px; -fx-text-fill: #6B8CAD;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #D9E8F5;"/>

            <VBox spacing="2" style="-fx-padding: 10 10 10 10;">
                <HBox alignment="CENTER_LEFT" onMouseClicked="#handleHome" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Accueil" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Rechercher" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Mes rendez-vous" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Documents" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Factures" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Messages" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Assistant IA" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8;">
                    <Label text="Notifications" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane>
                        <Circle radius="11" style="-fx-fill: #2B7FD4;"/>
                        <Label text="15" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    </StackPane>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-color: #D6E9F8; -fx-background-radius: 8;">
                    <Label text="Parametres" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;"/>
                </HBox>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>

            <HBox alignment="CENTER_LEFT" spacing="12" onMouseClicked="#handleLogout"
                  style="-fx-padding: 16 24 16 24; -fx-cursor: hand;">
                <Label text="Déconnexion" style="-fx-font-size: 13px; -fx-text-fill: #E05A2B; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 28 28 28 28; -fx-background-color: #EBF3FB;">

                <Label text="Parametres"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>

                <HBox spacing="16" alignment="TOP_LEFT">

                    <VBox spacing="16" HBox.hgrow="ALWAYS">
                        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                            <Label text="Photo de profil"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>
                            <StackPane alignment="CENTER">
                                <Circle fx:id="settingsAvatarCircle" radius="44"/>
                                <Label fx:id="settingsAvatarInitialsLabel" text="J"
                                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;"/>
                            </StackPane>
                            <HBox spacing="10" alignment="CENTER">
                                <Button text="Modifier la photo" onAction="#handleChangePhoto" HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: #EBF3FB; -fx-text-fill: #2B7FD4;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 8 0 8 0;
                                               -fx-border-color: #C8DDEF; -fx-border-radius: 8;"/>
                                <Button text="Supprimer la photo" onAction="#handleDeletePhoto" HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: #FFF4F4; -fx-text-fill: #C0392B;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 8 0 8 0;
                                               -fx-border-color: #F0C5C0; -fx-border-radius: 8;"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                            <Label text="Modifier le mot de passe"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>

                            <VBox spacing="6">
                                <Label text="Mot de passe actuel" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                <PasswordField fx:id="currentPasswordField" promptText="Mot de passe actuel"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Nouveau mot de passe" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Confirmer le nouveau mot de passe" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                <PasswordField fx:id="confirmNewPasswordField" promptText="Confirmer le nouveau mot de passe"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 10 12 10 12; -fx-font-size: 13px;"/>
                            </VBox>

                            <Button text="Modifier le mot de passe" onAction="#handleChangePassword"
                                    style="-fx-background-color: white; -fx-text-fill: #1A2C42;
                                           -fx-font-size: 13px; -fx-background-radius: 8;
                                           -fx-border-color: #C8DDEF; -fx-border-radius: 8;
                                           -fx-padding: 10 20 10 20;"/>
                        </VBox>
                    </VBox>

                    <VBox prefWidth="400" spacing="16">
                        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                            <Label text="Informations personnelles"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>

                            <VBox spacing="10">
                                <VBox spacing="5">
                                    <Label text="Prenom" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="prenomField" promptText="Jean"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Nom d'utilisateur" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="usernameField" promptText="Dupont"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Email" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="emailField" promptText="jean.dupont@email.com"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Telephone" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="phoneField" promptText="06 12 34 56 78"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Adresse" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="addressField" promptText="123 Rue de la Paix"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Ville" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="cityField" promptText="Paris"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Code postal" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="codePostalField" promptText="75001"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Pays" style="-fx-font-size: 12px; -fx-text-fill: #4A6B8A;"/>
                                    <TextField fx:id="countryField" promptText="France"
                                               style="-fx-background-color: #F2F7FB; -fx-background-radius: 8;
                                                      -fx-border-color: #D9E8F5; -fx-border-radius: 8;
                                                      -fx-padding: 8 10 8 10; -fx-font-size: 13px;"/>
                                </VBox>
                            </VBox>

                            <HBox alignment="CENTER_RIGHT">
                                <Button text="Enregistrer les modifications" onAction="#handleSaveProfile"
                                        style="-fx-background-color: #2B7FD4; -fx-text-fill: white;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-background-radius: 8; -fx-padding: 9 18 9 18;"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22; -fx-effect: dropshadow(gaussian, #c8d8e8, 10, 0, 0, 3);">
                            <Label text="Preferences de notification"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;"/>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Notifications par email" style="-fx-font-size: 13px; -fx-text-fill: #1A2C42;" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <CheckBox fx:id="emailNotifToggle" selected="true" style="-fx-padding: 0;"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Notifications par SMS" style="-fx-font-size: 13px; -fx-text-fill: #1A2C42;" HBox.hgrow="ALWAYS"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <CheckBox fx:id="smsNotifToggle" selected="true" style="-fx-padding: 0;"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
