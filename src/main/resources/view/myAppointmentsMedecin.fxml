<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.MedecinAppointmentsController"
            prefWidth="1200" prefHeight="720"
            stylesheets="@../css/doctor-pages.css"
            style="-fx-background-color: #EBF3FB;">

    <left>
        <fx:include source="sidebarMedecin.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 28; -fx-background-color: #EBF3FB;">
                <VBox spacing="4">
                    <Label text="Mes rendez-vous" styleClass="doctor-page-title"/>
                    <Label fx:id="subtitleLabel" text="Agenda de la semaine et détails de vos consultations." styleClass="doctor-page-subtitle"/>
                </VBox>

                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" spacing="6" styleClass="doctor-stat-card">
                        <Label text="Total semaine" styleClass="doctor-stat-label"/>
                        <Label fx:id="weekAppointmentsCountLabel" text="0" styleClass="doctor-stat-value blue-value"/>
                        <Label fx:id="weekAppointmentsMetaLabel" text="Rendez-vous planifies" styleClass="doctor-stat-label"/>
                    </VBox>

                    <VBox GridPane.columnIndex="1" spacing="6" styleClass="doctor-stat-card">
                        <Label text="Confirmes" styleClass="doctor-stat-label"/>
                        <Label fx:id="confirmedCountLabel" text="0" styleClass="doctor-stat-value green-value"/>
                        <Label fx:id="confirmedMetaLabel" text="Consultations valides" styleClass="doctor-stat-label"/>
                    </VBox>

                    <VBox GridPane.columnIndex="2" spacing="6" styleClass="doctor-stat-card">
                        <Label text="Termines" styleClass="doctor-stat-label"/>
                        <Label fx:id="completedCountLabel" text="0" styleClass="doctor-stat-value purple-value"/>
                        <Label fx:id="completedMetaLabel" text="Rendez-vous clotures" styleClass="doctor-stat-label"/>
                    </VBox>

                    <VBox GridPane.columnIndex="3" spacing="6" styleClass="doctor-stat-card">
                        <Label text="Téléconsultations" styleClass="doctor-stat-label"/>
                        <Label fx:id="teleconsultationsCountLabel" text="0" styleClass="doctor-stat-value orange-value"/>
                        <Label fx:id="teleconsultationsMetaLabel" text="A distance" styleClass="doctor-stat-label"/>
                    </VBox>
                </GridPane>

                <VBox spacing="12" styleClass="doctor-filter-card">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Agenda de la semaine" styleClass="doctor-section-title"/>
                            <Label fx:id="rangeLabel" text="Du 07/06 au 13/06" styleClass="doctor-filter-count"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="todayFilterButton" text="Aujourd'hui" onAction="#handleTodayFilter" styleClass="filter-chip"/>
                        <Button fx:id="allFilterButton" text="Tous" onAction="#handleAllFilter" styleClass="filter-chip"/>
                        <Button fx:id="confirmedFilterButton" text="Confirmés" onAction="#handleConfirmedFilter" styleClass="filter-chip"/>
                        <Button fx:id="completedFilterButton" text="Terminés" onAction="#handleCompletedFilter" styleClass="filter-chip"/>
                        <Button fx:id="cancelledFilterButton" text="Annulés" onAction="#handleCancelledFilter" styleClass="filter-chip"/>
                        <Button fx:id="teleconsultationFilterButton" text="Téléconsultation" onAction="#handleTeleconsultationFilter" styleClass="filter-chip"/>
                    </HBox>
                </VBox>

                <VBox fx:id="appointmentsContainer" spacing="12"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
