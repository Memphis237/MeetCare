<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1200" prefHeight="750"
            style="-fx-background-color: #F8F8F8;">

    <!-- ═══════════════════ SIDEBAR ═══════════════════ -->
    <left>
        <VBox prefWidth="280" spacing="0"
              style="-fx-background-color: #FFFFFF; -fx-border-color: #E8E8E8; -fx-border-width: 0 1 0 0;">

            <!-- Logo + menu hamburger -->
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding: 22 20 22 20;">
                <Label text="MediConnect Pro"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8B5CF6;" HBox.hgrow="ALWAYS"/>
                <Label text="= = ="
                       style="-fx-font-size: 14px; -fx-text-fill: #888888;"/>
            </HBox>

            <Separator/>

            <!-- Navigation -->
            <VBox spacing="0" style="-fx-padding: 8 8 8 8;">

                <!-- Tableau de bord -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[##]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Tableau de bord"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Agenda -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[=]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Agenda"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Patients -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[P]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Patients"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Disponibilites -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[O]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Disponibilites"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Documents -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[D]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Documents"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Facturation (actif) -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-color: #F3EEFE; -fx-background-radius: 8;">
                    <Label text="[$]"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #8B5CF6;
                                  -fx-background-color: #E4D5FC; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Facturation"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #8B5CF6;"/>
                </HBox>

                <!-- Messages -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[M]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Messages"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Statistiques -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-color: #F0F0F0; -fx-background-radius: 8;">
                    <Label text="[~]"
                           style="-fx-font-size: 12px; -fx-text-fill: #555555;
                                  -fx-background-color: #E0E0E0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Statistiques"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Profil public -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[@]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Profil public"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

                <!-- Parametres -->
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding: 12 16 12 16; -fx-background-radius: 8;">
                    <Label text="[#]"
                           style="-fx-font-size: 12px; -fx-text-fill: #888888;
                                  -fx-background-color: #F0F0F0; -fx-background-radius: 5; -fx-padding: 2 5 2 5;"/>
                    <Label text="Parametres"
                           style="-fx-font-size: 13px; -fx-text-fill: #333333;"/>
                </HBox>

            </VBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>

            <!-- Deconnexion -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 18 24 18 24;">
                <Label text="->"
                       style="-fx-font-size: 14px; -fx-text-fill: #E05A2B; -fx-font-weight: bold;"/>
                <Label text="Deconnexion"
                       style="-fx-font-size: 13px; -fx-text-fill: #E05A2B; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </left>

    <!-- ═══════════════════ CONTENU PRINCIPAL ═══════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 32 32 32 32; -fx-background-color: #F8F8F8;">

                <!-- En-tete : Titre + bouton Creer -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Facturation"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                        <Label text="Gerez vos factures et paiements"
                               style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                    </VBox>
                    <Button text="+ Creer une facture"
                            style="-fx-background-color: #8B5CF6; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 10; -fx-padding: 12 22 12 22;"/>
                </HBox>

                <!-- ── 4 cartes statistiques ── -->
                <HBox spacing="16">

                    <!-- Total factures -->
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22 24 22 24;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e0e0e0, 6, 0, 0, 2);">
                        <Label text="Total factures"
                               style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                        <Label text="4"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #8B5CF6;"/>
                    </VBox>

                    <!-- Revenus encaisses -->
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22 24 22 24;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e0e0e0, 6, 0, 0, 2);">
                        <Label text="Revenus encaisses"
                               style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                        <Label text="55.00 EUR"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3DAA70;"/>
                    </VBox>

                    <!-- En attente -->
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22 24 22 24;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e0e0e0, 6, 0, 0, 2);">
                        <Label text="En attente"
                               style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                        <Label text="55.00 EUR"
                               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #E05A2B;"/>
                    </VBox>

                    <!-- Factures payees -->
                    <VBox HBox.hgrow="ALWAYS" spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 22 24 22 24;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 12; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e0e0e0, 6, 0, 0, 2);">
                        <Label text="Factures payees"
                               style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>
                        <Label text="2"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;"/>
                    </VBox>

                </HBox>

                <!-- ── Liste Toutes les factures ── -->
                <VBox spacing="12">
                    <Label text="Toutes les factures"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>

                    <!-- Ligne separatrice -->
                    <Separator/>

                    <!-- Facture 1 : Marie Dubois - Payee (vert) -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18 20 18 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e8e8e8, 4, 0, 0, 1);">
                        <!-- Icone verte -->
                        <StackPane>
                            <Rectangle width="42" height="36" arcWidth="8" arcHeight="8"
                                       style="-fx-fill: #D4EDDA;"/>
                            <Label text="[$]"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3DAA70;"/>
                        </StackPane>
                        <!-- Infos -->
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Marie Dubois"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text="Consultation generale   -   05/05/2026"
                                   style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
                        </VBox>
                        <!-- Montant + badge -->
                        <VBox spacing="5" alignment="CENTER_RIGHT" minWidth="90">
                            <Label text="25 EUR"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text=" Payee "
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #3DAA70;
                                          -fx-background-color: #D4EDDA; -fx-background-radius: 5;
                                          -fx-padding: 3 8 3 8;"/>
                        </VBox>
                        <!-- Bouton Telecharger -->
                        <Button text="Telecharger"
                                style="-fx-background-color: white; -fx-text-fill: #444444;
                                       -fx-font-size: 12px; -fx-background-radius: 8;
                                       -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-padding: 8 16 8 16;"/>
                    </HBox>

                    <Separator style="-fx-opacity: 0.4;"/>

                    <!-- Facture 2 : Pierre Martin - Envoyee (bleu) -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18 20 18 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e8e8e8, 4, 0, 0, 1);">
                        <StackPane>
                            <Rectangle width="42" height="36" arcWidth="8" arcHeight="8"
                                       style="-fx-fill: #DBEAFE;"/>
                            <Label text="[$]"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;"/>
                        </StackPane>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Pierre Martin"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text="Consultation cardiologique   -   28/04/2026"
                                   style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT" minWidth="90">
                            <Label text="30 EUR"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text=" Envoyee "
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #3B82F6;
                                          -fx-background-color: #DBEAFE; -fx-background-radius: 5;
                                          -fx-padding: 3 8 3 8;"/>
                        </VBox>
                        <Button text="Telecharger"
                                style="-fx-background-color: white; -fx-text-fill: #444444;
                                       -fx-font-size: 12px; -fx-background-radius: 8;
                                       -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-padding: 8 16 8 16;"/>
                    </HBox>

                    <Separator style="-fx-opacity: 0.4;"/>

                    <!-- Facture 3 : Sophie Bernard - En attente (orange) -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18 20 18 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e8e8e8, 4, 0, 0, 1);">
                        <StackPane>
                            <Rectangle width="42" height="36" arcWidth="8" arcHeight="8"
                                       style="-fx-fill: #FDEBD0;"/>
                            <Label text="[$]"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #E05A2B;"/>
                        </StackPane>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Sophie Bernard"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text="Consultation generale   -   20/04/2026"
                                   style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT" minWidth="90">
                            <Label text="25 EUR"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text=" En attente "
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #E05A2B;
                                          -fx-background-color: #FDEBD0; -fx-background-radius: 5;
                                          -fx-padding: 3 8 3 8;"/>
                        </VBox>
                        <Button text="Telecharger"
                                style="-fx-background-color: white; -fx-text-fill: #444444;
                                       -fx-font-size: 12px; -fx-background-radius: 8;
                                       -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-padding: 8 16 8 16;"/>
                    </HBox>

                    <Separator style="-fx-opacity: 0.4;"/>

                    <!-- Facture 4 : Jean Lefebvre - Payee (vert) -->
                    <HBox spacing="16" alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 18 20 18 20;
                                 -fx-border-color: #EEEEEE; -fx-border-radius: 10; -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, #e8e8e8, 4, 0, 0, 1);">
                        <StackPane>
                            <Rectangle width="42" height="36" arcWidth="8" arcHeight="8"
                                       style="-fx-fill: #D4EDDA;"/>
                            <Label text="[$]"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3DAA70;"/>
                        </StackPane>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Jean Lefebvre"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text="Premiere consultation   -   15/04/2026"
                                   style="-fx-font-size: 12px; -fx-text-fill: #999999;"/>
                        </VBox>
                        <VBox spacing="5" alignment="CENTER_RIGHT" minWidth="90">
                            <Label text="30 EUR"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A;"/>
                            <Label text=" Payee "
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #3DAA70;
                                          -fx-background-color: #D4EDDA; -fx-background-radius: 5;
                                          -fx-padding: 3 8 3 8;"/>
                        </VBox>
                        <Button text="Telecharger"
                                style="-fx-background-color: white; -fx-text-fill: #444444;
                                       -fx-font-size: 12px; -fx-background-radius: 8;
                                       -fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-padding: 8 16 8 16;"/>
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
