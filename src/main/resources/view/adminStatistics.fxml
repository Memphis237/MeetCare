<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.AdminStatisticsController"
            prefWidth="1280" prefHeight="820"
            styleClass="admin-root"
            stylesheets="@../css/admin-pages.css">
    <left><fx:include source="sidebarAdmin.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="admin-content">
                <VBox spacing="4">
                    <Label text="Statistiques" styleClass="admin-title"/>
                    <Label text="Vue analytique de la plateforme" styleClass="admin-subtitle"/>
                </VBox>

                <FlowPane hgap="14" vgap="14" prefWrapLength="900">
                    <VBox styleClass="admin-stat-card" prefWidth="190">
                        <Label text="Total patients" styleClass="admin-stat-label"/>
                        <Label fx:id="totalPatientsLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #dc2626;"/>
                    </VBox>
                    <VBox styleClass="admin-stat-card" prefWidth="190">
                        <Label text="Total médecins" styleClass="admin-stat-label"/>
                        <Label fx:id="totalDoctorsLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #dc2626;"/>
                    </VBox>
                    <VBox styleClass="admin-stat-card" prefWidth="190">
                        <Label text="Total RDV" styleClass="admin-stat-label"/>
                        <Label fx:id="totalAppointmentsLabel" text="0" styleClass="admin-stat-value" style="-fx-text-fill: #dc2626;"/>
                    </VBox>
                    <VBox styleClass="admin-stat-card" prefWidth="190">
                        <Label text="Taux de remplissage" styleClass="admin-stat-label"/>
                        <Label fx:id="occupancyRateLabel" text="0%" styleClass="admin-stat-value" style="-fx-text-fill: #16a34a;"/>
                    </VBox>
                </FlowPane>

                <VBox styleClass="admin-card">
                    <Label text="Rendez-vous par mois" styleClass="admin-section-title"/>
                    <VBox fx:id="monthlyStatsContainer" spacing="18"/>
                </VBox>

                <HBox spacing="18">
                    <VBox styleClass="admin-card" HBox.hgrow="ALWAYS">
                        <Label text="Répartition des rendez-vous" styleClass="admin-section-title"/>
                        <VBox spacing="14">
                            <Label text="Rendez-vous confirmés" styleClass="admin-stat-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Region fx:id="confirmedShareBar" minHeight="16" prefHeight="16" styleClass="admin-progress-green"/>
                                <Label fx:id="confirmedShareLabel" text="0" styleClass="admin-muted"/>
                            </HBox>
                            <Label text="Rendez-vous annulés" styleClass="admin-stat-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Region fx:id="cancelledShareBar" minHeight="16" prefHeight="16" styleClass="admin-progress-red"/>
                                <Label fx:id="cancelledShareLabel" text="0" styleClass="admin-muted"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox styleClass="admin-card" HBox.hgrow="ALWAYS">
                        <Label text="Croissance mensuelle" styleClass="admin-section-title"/>
                        <VBox spacing="14">
                            <Label text="Nouveaux patients" styleClass="admin-stat-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Region fx:id="patientGrowthBar" minHeight="12" prefHeight="12" styleClass="admin-progress-blue"/>
                                <Label fx:id="patientGrowthLabel" text="0" styleClass="admin-muted"/>
                            </HBox>
                            <Label text="Nouveaux médecins" styleClass="admin-stat-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Region fx:id="doctorGrowthBar" minHeight="12" prefHeight="12" styleClass="admin-progress-purple"/>
                                <Label fx:id="doctorGrowthLabel" text="0" styleClass="admin-muted"/>
                            </HBox>
                            <Label text="Nouveaux RDV ce mois" styleClass="admin-stat-label"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Region fx:id="appointmentsGrowthBar" minHeight="12" prefHeight="12" styleClass="admin-progress-green"/>
                                <Label fx:id="appointmentsGrowthLabel" text="0" styleClass="admin-muted"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
