<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.AdminActivityController"
            prefWidth="1280" prefHeight="820"
            styleClass="admin-root"
            stylesheets="@../css/admin-pages.css">
    <left><fx:include source="sidebarAdmin.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="admin-content">
                <VBox spacing="4">
                    <Label text="Activité" styleClass="admin-title"/>
                    <Label text="Historique récent de la plateforme" styleClass="admin-subtitle"/>
                </VBox>
                <VBox fx:id="activityContainer" spacing="14"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
