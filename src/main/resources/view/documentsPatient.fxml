<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.meetcare.controller.DocumentsPatientController"
            prefWidth="1200"
            prefHeight="800"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 34;">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="6">
                        <Label text="Documents medicaux" style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                        <Label text="Consulte, filtre et telecharge tous tes documents" style="-fx-font-size: 18px; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="importButton"
                            text="⬆  Importer un document"
                            onAction="#handleImportDocument"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 10 20;"/>
                </HBox>

                <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 18 22 18 22; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Titre" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        <TextField fx:id="titleFilterField"
                                   promptText="Rechercher par titre"
                                   onAction="#handleFilterChange"
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #dbe5f0; -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 10 12;"/>
                    </VBox>

                    <VBox spacing="4" prefWidth="250">
                        <Label text="Type" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                        <ComboBox fx:id="typeFilterCombo"
                                  prefWidth="250"
                                  onAction="#handleFilterChange"
                                  style="-fx-background-color: #f8fafc; -fx-border-color: #dbe5f0; -fx-background-radius: 10; -fx-border-radius: 10;"/>
                    </VBox>
                </HBox>

                <VBox fx:id="recordsContainer" spacing="16"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
