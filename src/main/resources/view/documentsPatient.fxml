<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.DocumentsPatientController"
            prefWidth="1200"
            prefHeight="800"
            stylesheets="@../css/patient-pages.css"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 35;">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="6">
                        <Label text="Documents médicaux" style="-fx-font-size: 38px; -fx-font-weight: bold;"/>
                        <Label text="Tous vos documents en un seul endroit" style="-fx-font-size: 18px; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="⬆ Importer un document" onAction="#handleImportDocument" styleClass="primary-button"/>
                </HBox>

                <HBox spacing="20" alignment="CENTER_LEFT" styleClass="card">
                    <Label text="⚲" style="-fx-font-size: 26px; -fx-text-fill: #64748b;"/>
                    <ComboBox fx:id="doctorFilterComboBox" prefWidth="350" prefHeight="45"/>
                    <ComboBox fx:id="typeFilterComboBox" prefWidth="350" prefHeight="45"/>
                </HBox>

                <Label fx:id="documentsCountLabel" text="0 document" style="-fx-font-size: 18px; -fx-text-fill: #475569;"/>

                <VBox fx:id="documentsContainer" spacing="16"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
