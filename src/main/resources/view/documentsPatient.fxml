<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.meetcare.controller.DocumentsPatientController"
            prefWidth="1200" prefHeight="800"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="25" style="-fx-padding: 35;">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="6">
                        <Label text="Documents médicaux" style="-fx-font-size: 38px; -fx-font-weight: bold;"/>
                        <Label text="Tous vos documents en un seul endroit" style="-fx-font-size: 18px; -fx-text-fill: #64748b;"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="⬆  Importer un document" styleClass="primary-button"/>
                </HBox>

                <HBox spacing="20" alignment="CENTER_LEFT" styleClass="card">
                    <Label text="⚱" style="-fx-font-size: 26px; -fx-text-fill: #64748b;"/>

                    <ComboBox promptText="Tous les médecins" prefWidth="350" prefHeight="45"/>
                    <ComboBox promptText="Tous les types" prefWidth="350" prefHeight="45"/>
                </HBox>

                <Label text="5 document(s)" style="-fx-font-size: 18px; -fx-text-fill: #475569;"/>

                <VBox spacing="16">

                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="document-card">
                        <Label text="📄" styleClass="doc-icon"/>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Ordonnance" styleClass="document-title"/>
                            <Label text="Dr. Mathieu Bernard — Généraliste" styleClass="doctor-info"/>
                        </VBox>
                        <Label text="05/05/2026" styleClass="doctor-info"/>
                        <Label text="Ordonnance" styleClass="badge-blue"/>
                        <Button text="⬇  Télécharger" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="document-card">
                        <Label text="📄" styleClass="doc-icon"/>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Compte rendu de consultation" styleClass="document-title"/>
                            <Label text="Dr. Sarah Martin — Cardiologue" styleClass="doctor-info"/>
                        </VBox>
                        <Label text="28/04/2026" styleClass="doctor-info"/>
                        <Label text="Compte rendu" styleClass="badge-purple"/>
                        <Button text="⬇  Télécharger" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="document-card">
                        <Label text="📄" styleClass="doc-icon"/>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Résultats d'analyse sanguine" styleClass="document-title"/>
                            <Label text="Dr. Marc Dubois — Généraliste" styleClass="doctor-info"/>
                        </VBox>
                        <Label text="20/04/2026" styleClass="doctor-info"/>
                        <Label text="Analyse" styleClass="badge-green"/>
                        <Button text="⬇  Télécharger" styleClass="secondary-button"/>
                    </HBox>

                    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="document-card">
                        <Label text="📄" styleClass="doc-icon"/>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Radiographie thoracique" styleClass="document-title"/>
                            <Label text="Dr. Sophie Durand — Radiologue" styleClass="doctor-info"/>
                        </VBox>
                        <Label text="15/04/2026" styleClass="doctor-info"/>
                        <Label text="Radio" styleClass="badge-orange"/>
                        <Button text="⬇  Télécharger" styleClass="secondary-button"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>