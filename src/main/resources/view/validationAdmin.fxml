<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700" prefWidth="1100" style="-fx-background-color: #F0F2F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.meetcare.controller.ValidationAdminController">

    <left>
        <fx:include fx:id="sidebarAdmin" source="sidebarAdmin.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox spacing="20" style="-fx-padding: 36 36 36 36; -fx-background-color: #F0F2F5;">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Validations des comptes medecins" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                            <Label text="Consultez les dossiers envoyes et decidez de valider ou refuser chaque demande." style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" />
                        </VBox>
                        <VBox spacing="4" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 14 18 14 18; -fx-border-color: #E5E7EB; -fx-border-radius: 14;">
                            <Label text="Demandes en attente" style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" />
                            <Label fx:id="pendingCountLabel" text="0 en attente" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        </VBox>
                        <Button text="Actualiser" onAction="#handleRefresh" style="-fx-background-color: #EFF6FF; -fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 12 18 12 18;" />
                    </HBox>

                    <VBox spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Cartes de validation" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                            <Separator HBox.hgrow="ALWAYS" />
                        </HBox>

                        <VBox fx:id="cardsContainer" spacing="14" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
