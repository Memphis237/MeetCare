<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>


<VBox prefWidth="230" spacing="0" style="-fx-background-color: #FFFFFF; -fx-border-color: #D9E8F5; -fx-border-width: 0 1 0 0;" 
    xmlns="http://javafx.com/javafx/17" 
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.meetcare.controller.SidebarMedecinController">

    <!-- Logo MediConnect -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 22 20 22 20;">
        <!-- Icône croix médicale (simulée avec un Label stylisé) -->
        <Label style="-fx-text-fill: #2B7FD4; -fx-font-size: 22px; -fx-font-weight: bold;" text="✚" />
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;" text="MediConnect" />
    </HBox>

    <Separator style="-fx-background-color: #D9E8F5;" />

    <!-- Profil utilisateur -->
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 18 20 18 20;">
        <!-- Avatar placeholder -->
        <StackPane>
            <Circle fx:id="avatarCircle" radius="24" />
            <Label fx:id="avatarInitialsLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;" text="J" />
        </StackPane>
        <VBox spacing="2">
            <Label fx:id="patientNameLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1A2C42;" text="Jean" />
            <Label fx:id="roleLabel" style="-fx-font-size: 12px; -fx-text-fill: #6B8CAD;" text="Médecin" />
        </VBox>
    </HBox>

    <Separator style="-fx-background-color: #D9E8F5;" />

    <!-- Navigation -->
    <VBox spacing="2" style="-fx-padding: 10 10 10 10;">

        <!-- Accueil (actif) -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleHome" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-color: #D6E9F8; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 16px; -fx-text-fill: #2B7FD4;" text="⌂" />
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2B7FD4;" text="Accueil" />
        </HBox>

        <!-- Rechercher -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleSearchDoctor" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="🔍" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Rechercher" />
        </HBox>

        <!-- Mes rendez-vous -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleAppointments" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="📅" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Mes rendez-vous" />
        </HBox>

        <!-- Documents -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleDocuments" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="📄" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Documents" />
        </HBox>

        <!-- Factures -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleInvoices" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="💲" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Factures" />
        </HBox>

        <!-- Messages -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleMessages" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="💬" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Messages" />
        </HBox>

        <!-- Assistant IA -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleMessages" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="🤖" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Assistant IA" />
        </HBox>

        <!-- Notifications avec badge -->
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="🔔" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Notifications" />
            <Region HBox.hgrow="ALWAYS" />
            <StackPane>
                <Circle radius="10" style="-fx-fill: #2B7FD4;" />
                <Label style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: white;" text="15" />
            </StackPane>
        </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" onMouseClicked="#handleValidation" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
               <children>
                  <Label prefHeight="20.0" prefWidth="63.0" style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="🔓✔" />
                  <Label prefHeight="19.0" prefWidth="130.0" style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Validation compte" />
                  <Region HBox.hgrow="ALWAYS" />
                  <StackPane />
               </children>
            </HBox>

        <!-- Paramètres -->
        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleSettings" spacing="12" style="-fx-padding: 10 14 10 14; -fx-background-radius: 8; -fx-cursor: hand;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #4A6B8A;" text="⚙" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #4A6B8A;" text="Paramètres" />
        </HBox>

    </VBox>

          <!-- Spacer -->
    <Region VBox.vgrow="ALWAYS" />

    <Separator style="-fx-background-color: #D9E8F5;" />

    <!-- Déconnexion -->
    <HBox alignment="CENTER_LEFT" onMouseClicked="#handleLogout" spacing="12" style="-fx-padding: 16 24 16 24; -fx-cursor: hand;">
        <Label style="-fx-font-size: 13px; -fx-text-fill: red;" text="Déconnexion" />
    </HBox>

</VBox>
