<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane
    prefHeight="740" prefWidth="620"
    style="-fx-background-color: linear-gradient(to bottom right, #a8c8f0, #d6eaf8);"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.example.meetcare.controller.RegisterController">

    <!-- Carte blanche centrée -->
    <VBox alignment="CENTER" spacing="14"
          prefWidth="400"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,40,100,0.18), 28, 0, 0, 8);"
          StackPane.alignment="CENTER">

        <padding>
            <Insets top="36" right="50" bottom="36" left="50"/>
        </padding>

        <!-- Icône cercle bleu -->
        <StackPane prefWidth="72" prefHeight="72" maxWidth="72" maxHeight="72"
                   style="-fx-background-color: #2f6fd4; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(47,111,212,0.4), 12, 0, 0, 4);"
                   StackPane.alignment="CENTER">
            <Label text="👤" style="-fx-font-size: 28px;"/>
        </StackPane>

        <!-- Titre -->
        <Label text="Créer un compte"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a2540;"/>

        <!-- Message retour -->
        <Label fx:id="messageLabel" wrapText="true" maxWidth="300" styleClass="msg-label"/>

        <!-- Prénom -->
        <VBox spacing="5">
            <Label text="Prénom" styleClass="form-label"/>
            <TextField fx:id="prenom" promptText="Jean" styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Nom d'utilisateur -->
        <VBox spacing="5">
            <Label text="Nom d'utilisateur" styleClass="form-label"/>
            <TextField fx:id="username" promptText="Dupont" styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Email -->
        <VBox spacing="5">
            <Label text="Email" styleClass="form-label"/>
            <TextField fx:id="email" promptText="jean.dupont@example.com" styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Téléphone -->
        <VBox spacing="5">
            <Label text="Téléphone" styleClass="form-label"/>
            <TextField fx:id="telephone" promptText="06 00 00 00 00" styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Mot de passe -->
        <VBox spacing="5">
            <Label text="Mot de passe" styleClass="form-label"/>
            <PasswordField fx:id="password" promptText="••••••••" styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Confirmation mot de passe -->
        <VBox spacing="5">
            <Label text="Confirmation mot de passe" styleClass="form-label"/>
            <PasswordField fx:id="confirmPassword" promptText="••••••••" styleClass="auth-field" prefWidth="300"/>
        </VBox>

        <!-- Bouton S'inscrire -->
        <Button text="S'inscrire" onAction="#handleInscription"
                styleClass="btn-primary" prefWidth="300"/>

        <!-- Lien connexion -->
        <Hyperlink fx:id="hyperlink" text="Déjà un compte ? Se connecter"
                   onAction="#handleBackToLogin" styleClass="auth-link"/>

        <!-- Cadenas décoratif -->
        <Label text="🔒" style="-fx-font-size: 18px; -fx-text-fill: #c5d0dc; -fx-opacity: 0.7;"/>

    </VBox>
</StackPane>
