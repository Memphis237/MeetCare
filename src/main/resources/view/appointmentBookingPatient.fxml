<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.meetcare.controller.AppointmentBookingPatientController"
            prefWidth="1200"
            prefHeight="800"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="22" style="-fx-padding: 30;">
                <VBox spacing="6">
                    <Label text="Prendre un rendez-vous" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="Choisis un medecin, une date et un creneau disponible." style="-fx-font-size: 16px; -fx-text-fill: #64748b;"/>
                </VBox>

                <VBox spacing="18" style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 24; -fx-border-color: #e5e7eb; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                    <HBox spacing="18">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Médecin" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="doctorComboBox"
                                      onAction="#handleDoctorSelection"
                                      prefHeight="46"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #dbe5f0; -fx-background-radius: 12; -fx-border-radius: 12;"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Date" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <DatePicker fx:id="appointmentDatePicker"
                                        onAction="#handleDateChange"
                                        prefHeight="46"
                                        style="-fx-background-color: #f8fafc; -fx-border-color: #dbe5f0; -fx-background-radius: 12; -fx-border-radius: 12;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="18">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Heure" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="timeComboBox"
                                      prefHeight="46"
                                      style="-fx-background-color: #f8fafc; -fx-border-color: #dbe5f0; -fx-background-radius: 12; -fx-border-radius: 12;"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Motif" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <TextField fx:id="motifField"
                                       promptText="Consultation, suivi..."
                                       prefHeight="46"
                                       style="-fx-background-color: #f8fafc; -fx-border-color: #dbe5f0; -fx-background-radius: 12; -fx-border-radius: 12; -fx-padding: 10 12;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="18" alignment="TOP_LEFT">
                        <VBox spacing="8" prefWidth="360" style="-fx-background-color: #f8fbff; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #e0ebff; -fx-border-radius: 16;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Circle fx:id="doctorAvatarCircle" radius="24" style="-fx-fill: #dbeafe;"/>
                                <VBox spacing="2">
                                    <Label fx:id="doctorNameLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Dr. Martin" />
                                    <Label fx:id="doctorSpecialityLabel" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="Cardiologie" />
                                </VBox>
                            </HBox>

                            <Label text="Adresse" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label fx:id="doctorAddressLabel" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="Adresse du médecin"/>

                            <Label text="Créneaux disponibles" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #111827; -fx-padding: 8 0 0 0;"/>
                            <Label text="De 09:00 à 16:00" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;"/>

                            <Label fx:id="availabilityHintLabel"
                                   wrapText="true"
                                   style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-background-radius: 12; -fx-padding: 10 12; -fx-font-size: 12px;"
                                   text="Choisis une date et une heure pour vérifier la disponibilité."/>
                        </VBox>

                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="Résumé" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <VBox spacing="8" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-padding: 18; -fx-border-color: #e5e7eb; -fx-border-radius: 16;">
                                <Label fx:id="summaryDoctorLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Médecin: -" />
                                <Label fx:id="summaryDateLabel" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="Date: -" />
                                <Label fx:id="summaryTimeLabel" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="Heure: -" />
                                <Label fx:id="summaryMotifLabel" style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="Motif: -" />
                            </VBox>

                            <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
                                <Button text="Annuler"
                                        onAction="#handleCancel"
                                        style="-fx-background-color: #eef2f7; -fx-text-fill: #64748b; -fx-font-size: 15px; -fx-background-radius: 12; -fx-padding: 10 18;"/>
                                <Button text="Confirmer"
                                        onAction="#handleConfirm"
                                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-size: 15px; -fx-background-radius: 12; -fx-padding: 10 18;"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
