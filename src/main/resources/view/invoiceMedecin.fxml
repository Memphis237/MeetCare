<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.InvoiceMedecinController"
            prefWidth="1200"
            prefHeight="760"
            stylesheets="@../css/doctor-pages.css"
            style="-fx-background-color: #f8fafc;">

    <left>
        <fx:include source="sidebarMedecin.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 18 18 24 18;">
                <VBox spacing="2">
                    <Label text="Facturation" styleClass="doctor-title"/>
                    <Label text="Suivez vos paiements et vos factures" styleClass="doctor-subtitle"/>
                </VBox>

                <HBox spacing="16">
                    <VBox spacing="8" styleClass="doctor-card" HBox.hgrow="ALWAYS">
                        <Label text="Factures émises" styleClass="doctor-subtitle"/>
                        <Label fx:id="totalInvoicesValueLabel" text="0" styleClass="doctor-stat-value"/>
                    </VBox>
                    <VBox spacing="8" styleClass="doctor-card" HBox.hgrow="ALWAYS">
                        <Label text="Revenus encaissés" styleClass="doctor-subtitle"/>
                        <Label fx:id="totalRevenueValueLabel" text="0 €" styleClass="doctor-stat-value"/>
                    </VBox>
                    <VBox spacing="8" styleClass="doctor-card" HBox.hgrow="ALWAYS">
                        <Label text="En attente" styleClass="doctor-subtitle"/>
                        <Label fx:id="pendingRevenueValueLabel" text="0 €" styleClass="doctor-stat-value"/>
                    </VBox>
                    <VBox spacing="8" styleClass="doctor-card" HBox.hgrow="ALWAYS">
                        <Label text="Factures payées" styleClass="doctor-subtitle"/>
                        <Label fx:id="paidInvoicesValueLabel" text="0" styleClass="doctor-stat-value"/>
                    </VBox>
                </HBox>

                <VBox fx:id="invoicesContainer" spacing="12"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
