<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21.0.6"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.AdminNotificationsController"
            prefWidth="1280" prefHeight="820"
            styleClass="admin-root"
            stylesheets="@../css/admin-pages.css">
    <left><fx:include source="sidebarAdmin.fxml"/></left>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="admin-content">
                <VBox spacing="4">
                    <Label text="Notifications" styleClass="admin-title"/>
                    <Label text="Suivi des notifications plateforme" styleClass="admin-subtitle"/>
                </VBox>
                <HBox styleClass="admin-card">
                    <ComboBox fx:id="filterComboBox" prefWidth="220" styleClass="admin-filter-combo"/>
                </HBox>
                <VBox fx:id="notificationsContainer" spacing="14"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
