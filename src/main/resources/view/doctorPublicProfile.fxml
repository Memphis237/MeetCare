<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.meetcare.controller.DoctorPublicProfileController"
            prefWidth="1200"
            prefHeight="800"
            stylesheets="@../css/patient-pages.css"
            style="-fx-background-color: #f4f7fb;">

    <left>
        <fx:include source="sidebarPatient.fxml"/>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="18" style="-fx-padding: 24;">
                <VBox spacing="18" style="-fx-background-color: linear-gradient(to right, #0f172a, #1d4ed8); -fx-background-radius: 24; -fx-padding: 28; -fx-effect: dropshadow(gaussian, rgba(15, 23, 42, 0.22), 18, 0, 0, 6);">
                    <HBox alignment="CENTER_LEFT" spacing="18">
                        <StackPane>
                            <Circle fx:id="avatarCircle" radius="42" style="-fx-fill: rgba(255,255,255,0.18); -fx-stroke: rgba(255,255,255,0.28); -fx-stroke-width: 1.5;"/>
                            <Label fx:id="avatarInitialsLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="D"/>
                        </StackPane>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label fx:id="doctorNameLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="Dr. Nom Prenom"/>
                            <Label fx:id="specialityLabel" style="-fx-font-size: 17px; -fx-text-fill: #dbeafe;" text="Spécialité"/>
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #c7d2fe;" text="📍"/>
                                <Label fx:id="cityLabel" style="-fx-font-size: 13px; -fx-text-fill: #c7d2fe;" text="Ville"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="statusLabel" style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 6 12; -fx-font-size: 12px;" text="Profil public"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="10" alignment="CENTER_RIGHT">
                            <Button fx:id="bookAppointmentButton" onAction="#handleBookAppointment" style="-fx-background-color: white; -fx-text-fill: #1d4ed8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 12; -fx-padding: 12 18;" text="Prendre rendez-vous"/>
                            <Button fx:id="previewBackButton" onAction="#handleBackToSearch" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 12; -fx-padding: 10 18;" text="Retour à la recherche"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <Label style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 14; -fx-font-size: 12px;" text="Profil dynamique"/>
                        <Label style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 14; -fx-font-size: 12px;" text="Consultation"/>
                        <Label style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 999; -fx-padding: 8 14; -fx-font-size: 12px;" text="Téléconsultation"/>
                    </HBox>
                </VBox>

                <HBox spacing="18">
                        <VBox spacing="18" HBox.hgrow="ALWAYS">
                        <VBox spacing="12" styleClass="card" prefHeight="240" maxHeight="240" minHeight="240">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Présentation"/>
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" prefHeight="160.0" maxHeight="160.0" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;">
                                <content>
                                    <Label fx:id="biographyLabel" wrapText="true" maxWidth="1.7976931348623157E308" style="-fx-font-size: 14px; -fx-text-fill: #4b5563; -fx-line-spacing: 4;" text="Biographie du médecin"/>
                                </content>
                            </ScrollPane>
                        </VBox>

                        <VBox spacing="12" styleClass="card">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Expertise et cabinet"/>
                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 14;">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Secteur"/>
                                    <Label fx:id="sectorLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Secteur 1"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 14;">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Expérience"/>
                                    <Label fx:id="experienceLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="10 ans"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 14;">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Prix consultation"/>
                                    <Label fx:id="consultationPriceLabel" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="70,00 €"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS" style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 14;">
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Adresse du cabinet"/>
                                    <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Voir le panneau Cabinet"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox prefWidth="320" spacing="18">
                        <VBox spacing="12" styleClass="card">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Informations clés"/>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Carte Vitale"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="acceptsVitaleLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Oui"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Téléconsultation"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="teleconsultationLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Disponible"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="12" styleClass="card">
                            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Cabinet"/>
                            <Label fx:id="addressLabel" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #4b5563;" text="Adresse du cabinet"/>
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #64748b;" text="Les informations affichées sont synchronisées avec le profil public du médecin."/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
